# =============================================================================
# MySQL 8.4 — AAA 프로젝트 커스텀 설정
# =============================================================================
# 마운트: ${AAA_SSD_BASE}/config/mysql/my.cnf → /etc/mysql/conf.d/my.cnf:ro
# 기본값 위에 덮어쓰기되므로 변경이 필요한 항목만 명시한다.
# =============================================================================

[mysqld]

# --- 문자셋 ---
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# --- 시간대 (KST 통일, ADR-009) ---
default_time_zone = '+09:00'

# --- InnoDB ---
# NAS 8GB RAM 기준 메모리 예산: MySQL 컨테이너 limit 768MB, InnoDB 버퍼풀 512MB
# TECHSPEC 10.3절 참조
innodb_buffer_pool_size = 512M

# --- 바이너리 로그 (PITR 백업용, TECHSPEC 10.6절) ---
binlog_expire_logs_seconds = 2592000
max_binlog_size = 1073741824

# --- 일반 로그 ---
# 슬로우 쿼리 로그: 1초 이상 쿼리 기록
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# 에러 로그
log_error = /var/log/mysql/error.log
# --- 클라이언트 기본 문자셋 ---
# character_set_server만으로는 mysql CLI 클라이언트 자체 기본값(컴파일 기본 latin1)에 영향 없음.
# --default-character-set=utf8mb4 수동 지정 없이도 접속 시 항상 utf8mb4가 되도록 명시.
[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
