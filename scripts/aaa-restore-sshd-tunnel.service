# =============================================================================
# aaa-restore-sshd-tunnel.service — 부팅 시 db_tunnel Match 블록 복구
# =============================================================================
# UGOS 업데이트/재부팅으로 /etc/ssh/sshd_config가 재생성되면 db_tunnel
# 계정용 `Match User db_tunnel` 블록(AllowTcpForwarding yes + PermitOpen)이
# 사라져 db_tunnel의 -L 포트포워딩이 접속 즉시 끊긴다(2026-08-13 실측 —
# SPEC-ANALYZER-TRAIN-AUTOMATION-001 수동 학습 실행 중 발견, #118 ACL 장애와
# 동일 재부팅 시각에 sshd_config도 함께 재생성된 것으로 추정). sshd가 시작하기
# 전에 restore-sshd-db-tunnel.sh로 블록을 선제 복구한다.
#
# 설치 (NAS, root):
#   cp scripts/aaa-restore-sshd-tunnel.service /etc/systemd/system/
#   # ExecStart 경로를 실제 배포 경로로 수정했는지 확인
#   systemctl daemon-reload
#   systemctl enable aaa-restore-sshd-tunnel.service
#
# 검증:
#   systemctl status aaa-restore-sshd-tunnel.service
#   journalctl -u aaa-restore-sshd-tunnel.service -b
#
# 순서: sshd 자체가 시작하기 전에 블록을 파일에 써 넣어야 첫 기동부터 올바른
# 설정으로 뜬다(사후 reload에 의존하지 않는다). ssh.service 실제 유닛명이
# 다른 NAS 모델/UGOS 버전에서 다를 수 있으니 설치 전
# `systemctl list-units --type=service | grep -i ssh`로 재확인할 것.
#
# [HARD] 순서 지정 함정(2026-08-31 실측, aaa-reset-acl.service #118과 동일 원인):
#   최초 배포판은 After=local-fs.target만 지정했는데, 이 시점엔 UGOS의
#   /volume1/SSD_1 마운트가 아직 준비되지 않아 WorkingDirectory chdir이
#   실패했다(status=200/CHDIR, 2026-08-30 16:46:42 KST 재부팅에서 확인 —
#   서비스는 enabled 상태였지만 매 부팅 실패, db_tunnel 포트포워딩이 계속
#   막혀 있었다). aaa-reset-acl.service가 이미 겪은 것과 동일한 함정이므로
#   동일하게 storage_serv.service/filemgr_serv.service를 After=에 병기한다.
#   NAS 모델·UGOS 버전이 다르면 `systemctl show docker_serv.service -p
#   WantedBy,After`(또는 storage_serv.service)로 재확인할 것.
#
# 커버리지 공백: 이 유닛은 부팅 시에만 발동한다. UGOS는 재부팅 없이 백그라운드로
# 설정을 재적용할 수 있어(aaa-reset-acl #148과 동일 성격) 부팅 훅만으로는
# 재발을 막지 못한다. aaa-restore-sshd-tunnel.timer를 함께 등록해 동일
# 서비스를 주기적으로 재실행할 것 — 설치 방법은 해당 timer 파일 헤더 참고.
# =============================================================================
[Unit]
Description=AAA NAS sshd db_tunnel Match Block Restore
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target storage_serv.service filemgr_serv.service
Before=ssh.service

[Service]
Type=oneshot
WorkingDirectory=/volume1/SSD_1/Development/aaa/aaa-infra
ExecStart=/bin/bash /volume1/SSD_1/Development/aaa/aaa-infra/scripts/restore-sshd-db-tunnel.sh
RemainAfterExit=no
# 실패해도 sshd 기동 자체는 막지 않는다(전역 설정으로도 SSH 접속 자체는
# 가능하므로) — 실패 시 journalctl로 원인 확인 후 수동 재실행한다.
SuccessExitStatus=0
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
