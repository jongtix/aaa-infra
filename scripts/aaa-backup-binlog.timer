# =============================================================================
# aaa-backup-binlog.timer — binlog 회전+복사 스케줄러 (SPEC-INFRA-DB-BACKUP-001)
# =============================================================================
# 매시 5분(OnCalendar=*-*-* *:05:00)에 aaa-backup-binlog.service를 발화한다.
# FLUSH BINARY LOGS + 닫힌 binlog 파일 복사 + daily 등급 최고(最古) 덤프
# 기준(+1일 여유) 프루닝을 수행한다(design.md §1, REQ-BK-010~012). 매시
# 1시간 주기 채택 근거: 2026-08-20 사용자 확정 — "비용이 무시 가능하면
# 최대한 자주"에 따른 회전+복사 방식의 실질 최대 빈도(RPO ≤ 1시간). 분(5분)
# 오프셋은 2026-08-24 사용자 확정(spec.md v0.5.2) — 정각 발화(구
# OnCalendar=hourly)는 매일 05:00:00에 daily 풀 덤프 타이머
# (aaa-backup-mysql.timer)와 동일 인스턴트에 같은 aaa-mysql 컨테이너를
# 상대로 동시 발화하는 충돌이 하루 1회 발생해, 이를 회피하기 위해 5분
# 오프셋을 채택했다(REQ-BK-010).
#
# systemd **USER** scope 유닛이다 — aaa-backup-mysql.timer와 동일 원칙
# (root 전용 지시자 미사용, sudo 불요, 별도 유닛).
#
# OnCalendar=*-*-* *:05:00은 호스트 로컬 타임존 매시 5분에 발화한다. KST
# 매시 5분 발화를 의도하므로 NAS 호스트 타임존이 KST여야 한다 — 설치 전
# `timedatectl`로 `Time zone: Asia/Seoul` 확인 필수(aaa-backup-mysql.timer와
# 동일 주의).
#
# 설치 (NAS, 배포 계정 — sudo 불요):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/aaa-backup-binlog.timer scripts/aaa-backup-binlog.service \
#      ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aaa-backup-binlog.timer
#
# 검증:
#   timedatectl
#   systemctl --user is-active aaa-backup-binlog.timer
#   systemctl --user list-timers aaa-backup-binlog.timer
#   journalctl --user -u aaa-backup-binlog.service -n 50
#
# 전제조건: aaa-backup-mysql.timer와 동일(PREP-2/PREP-3/M5 선행 필요) — 최고(最古)
# 덤프 기준 프루닝 로직이 최초 풀 덤프 존재를 전제하므로, 풀 덤프 타이머가
# 최소 1회 성공한 뒤 binlog 타이머를 활성화하는 순서를 권장한다.
# =============================================================================
[Unit]
Description=AAA MySQL Binlog Rotation Timer (SPEC-INFRA-DB-BACKUP-001)

[Timer]
OnCalendar=*-*-* *:05:00
Persistent=true

[Install]
WantedBy=timers.target
