# =============================================================================
# aaa-backup-mysql.timer — MySQL 풀 덤프 스케줄러 (SPEC-INFRA-DB-BACKUP-001)
# =============================================================================
# 매일 05:00 KST에 aaa-backup-mysql.service를 발화한다. mysqldump 풀 덤프 +
# zstd 압축 + 무결성 검증 + GFS 보존(일간 7/주간 4/월간 6)을 수행한다
# (design.md §1, REQ-BK-001~006).
#
# systemd **system(root)** scope 유닛이다 — 2026-09-03 aaa-reset-acl.service와
# 동일한 root-scope 패턴으로 전환했다(UGOS 재부팅 후 user-scope timer가
# 자동 기동되지 않는 문제 대응).
#
# OnCalendar는 systemd가 실행되는 **호스트 로컬 타임존**으로 해석된다.
# 05:00이 실제 05:00 KST로 발화하려면 NAS 호스트 타임존이 KST여야 한다 —
# 설치 전 `timedatectl` 로 `Time zone: Asia/Seoul`인지 반드시 사전 확인할 것.
# (Local time == UTC 이면 05:00 UTC = 14:00 KST로 발화하므로 반드시 확인)
#
# 설치 (NAS, root):
#   sudo mkdir -p /etc/systemd/system
#   sudo cp scripts/aaa-backup-mysql.timer scripts/aaa-backup-mysql.service \
#      /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now aaa-backup-mysql.timer
#
# 검증:
#   timedatectl                                    # Time zone: Asia/Seoul 확인
#   systemctl is-active aaa-backup-mysql.timer
#   systemctl list-timers aaa-backup-mysql.timer
#   journalctl -u aaa-backup-mysql.service -n 50
#
# 전제조건(PREP-5, 사용자 수동): PREP-2(백업 계정 GRANT 라이브 적용) +
# PREP-3(자격증명 파일 생성) + M5(docker-compose.yml ro 마운트, 본 파일과
# 함께 커밋됨)가 선행되어야 첫 자동 실행이 성공한다.
# =============================================================================
[Unit]
Description=AAA MySQL Full Backup Timer (SPEC-INFRA-DB-BACKUP-001)

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
