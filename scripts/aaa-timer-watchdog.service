# =============================================================================
# aaa-timer-watchdog.service — 백업 타이머 self-heal 감시 (SPEC-INFRA-DB-BACKUP-001)
# =============================================================================
# aaa-backup-mysql.timer / aaa-backup-binlog.timer / aaa-backup-restore-drill.timer가
# 재부팅·UGOS 업데이트로 inactive(dead) 상태로 방치되는 걸 막는다
# (2026-08-30 재부팅 사고 대응). aaa-restore-sshd-tunnel.service와 동일한
# self-heal 패턴 — 대상 유닛이 active면 아무것도 하지 않는 멱등 스크립트를
# 짧은 주기로 재실행한다.
#
# systemd USER scope 유닛이다 — sudo 불요.
# =============================================================================
[Unit]
Description=AAA backup timer watchdog — periodic re-arm

[Service]
Type=oneshot
WorkingDirectory=/volume1/SSD_1/Development/aaa/aaa-infra
ExecStart=/usr/bin/env bash scripts/watchdog-restart-timers.sh aaa-backup-mysql.timer aaa-backup-binlog.timer aaa-backup-restore-drill.timer
