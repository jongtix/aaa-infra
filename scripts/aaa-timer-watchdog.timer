# =============================================================================
# aaa-timer-watchdog.timer — 백업 타이머 주기 재확인 (SPEC-INFRA-DB-BACKUP-001)
# =============================================================================
# aaa-restore-sshd-tunnel.timer와 동일한 간격 정책 — 부팅 5분 후 최초 실행,
# 이후 30분마다 aaa-timer-watchdog.service를 재실행해 대상 백업 타이머 3개의
# inactive(dead) 방치를 짧은 주기로 스스로 복구한다.
#
# 설치 (NAS, 배포 계정 — sudo 불요):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/aaa-timer-watchdog.service scripts/aaa-timer-watchdog.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aaa-timer-watchdog.timer
#
# 검증:
#   systemctl --user list-timers aaa-timer-watchdog.timer
#   journalctl --user -u aaa-timer-watchdog.service -n 50
# =============================================================================
[Unit]
Description=AAA backup timer watchdog — periodic re-arm

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true
Unit=aaa-timer-watchdog.service

[Install]
WantedBy=timers.target
