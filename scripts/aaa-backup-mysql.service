# =============================================================================
# aaa-backup-mysql.service — MySQL 풀 덤프 실행 유닛 (SPEC-INFRA-DB-BACKUP-001)
# =============================================================================
# aaa-backup-mysql.timer(매일 05:00 KST)가 발화한다. backup-mysql.sh를
# --mode=full로 호출 — mysqldump 풀 덤프 + zstd 압축 + 무결성 검증 + GFS
# 보존(일간 7/주간 4/월간 6) + 데드맨 메트릭 푸시(REQ-BK-001~006, M4).
#
# systemd **system(root)** scope 유닛이다 — 2026-09-03 user-scope timer가
# UGOS 재부팅 후 자동 기동되지 않는 문제(db_tunnel/aaa-restore-sshd-tunnel과
# 동일 사고 패턴)를 겪어 root-scope로 전환했다. aaa-reset-acl.service와
# 동일한 After= 체인을 사용한다.
#
# WorkingDirectory/ExecStart 경로는 실제 NAS 배포 경로로 맞춰져 있다
# (${AAA_SSD_BASE} 실측값, project_nas_infra_deploy_method 메모리 참조).
# 배포 경로가 다르면 두 값 모두 수정할 것.
#
# 설치 (NAS, root): aaa-backup-mysql.timer 헤더 주석 참조(동일 절차).
# 검증:
#   systemctl status aaa-backup-mysql.service
#   journalctl -u aaa-backup-mysql.service -b
#   sudo systemctl start aaa-backup-mysql.service   # 수동 1회 실행(즉시 검증용)
# =============================================================================
[Unit]
Description=AAA MySQL Full Backup (SPEC-INFRA-DB-BACKUP-001)
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target storage_serv.service filemgr_serv.service docker_serv.service docker.socket docker.service

[Service]
Type=oneshot
WorkingDirectory=/volume1/SSD_1/Development/aaa/aaa-infra
EnvironmentFile=/volume1/SSD_1/Development/aaa/aaa-infra/.env
ExecStart=/bin/bash /volume1/SSD_1/Development/aaa/aaa-infra/scripts/backup-mysql.sh --mode=full
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
