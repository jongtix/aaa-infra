# =============================================================================
# aaa-reset-acl.service — 부팅 시 UGOS ACL 리셋 (aaa-infra#118)
# =============================================================================
# UGOS 업데이트/재부팅으로 공유폴더(SSD_1/HDD_1)에 UGOS 전용 ACL이 재적용되면
# mysql/redis/alertmanager/vector(비루트 uid 실행) 컨테이너가 로그·상태 파일을
# open하지 못해 크래시루프에 빠진다. docker 기동 전에 init-nas.sh --reset-acl을
# 실행해 ACL을 선제 리셋한다.
#
# 설치 (NAS, root):
#   cp scripts/aaa-reset-acl.service /etc/systemd/system/
#   # ExecStart 경로를 실제 배포 경로로 수정했는지 확인
#   systemctl daemon-reload
#   systemctl enable aaa-reset-acl.service
#
# 검증:
#   systemctl status aaa-reset-acl.service
#   journalctl -u aaa-reset-acl.service -b
#
# 순서 지정 실측 (UGREEN DXP2800, 2026-07-26 `systemctl show` 확인):
#   docker.service는 UnitFileState=disabled이고 docker.socket 활성화로만 뜬다 —
#   부팅 체인에 정적으로 편입되지 않으므로 Before=docker.service 단독으로는
#   순서 보장이 안 된다. 실제 부팅 체인은
#     multi-user.target → docker_serv.service(WantedBy=multi-user.target, enabled)
#       → docker.socket(WantedBy=docker_serv.service) → docker.service(소켓 활성화)
#   이다. docker_serv.service(UGOS 자체 도커 관리자, 재부팅 시 실제 시작 지점)를
#   1차 대상으로 Before=에 명시하고, docker.socket/docker.service는 방어적으로 병기한다.
#   docker_serv.service 자체가 storage_serv.service·filemgr_serv.service 이후에
#   시작하므로(스토리지·ACL 계층), 이 유닛도 동일하게 그 뒤에 실행되도록 After=에 병기한다.
#   NAS 모델·UGOS 버전이 다르면 `systemctl show docker_serv.service -p WantedBy,After`로
#   재확인할 것 — 유닛명이 다르면 아래 Before=/After=를 그에 맞게 수정해야 한다.
#
# 주의: docker_serv.service 자체가 UGOS 업데이트로 깨지는 경우(예: runner systemd
# 유닛 손상 전례, project_nas_runner_autorestart 참고)는 이 유닛으로 해결되지
# 않는다. 독립 감지 경로(호스트 cron 하트비트)를 반드시 병행한다.
# =============================================================================
[Unit]
Description=AAA NAS UGOS ACL Reset (aaa-infra#118)
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target storage_serv.service filemgr_serv.service
Before=docker_serv.service docker.socket docker.service

[Service]
Type=oneshot
# 실제 배포 경로로 수정할 것 (예: /volume1/SSD_1/Development/aaa/aaa-infra)
WorkingDirectory=/volume1/SSD_1/Development/aaa/aaa-infra
ExecStart=/bin/bash /volume1/SSD_1/Development/aaa/aaa-infra/scripts/init-nas.sh --reset-acl
RemainAfterExit=no
# ACL 미해제 등 예상 밖 실패로 부팅 자체가 막히지 않도록 실패해도 부팅을 계속한다.
# 실패 시 journalctl로 원인을 확인하고 수동으로 재실행한다.
SuccessExitStatus=0
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
